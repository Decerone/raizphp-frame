// ==================== FUNCIÓN DE LOTES ====================
function procesarLote(string $items, callable $callback): array
{
    $resultados = [];
    $lista = array_map('trim', explode(',', $items));
    foreach ($lista as $item) {
        if (!empty($item)) {
            $resultados = array_merge($resultados, $callback($item));
        }
    }
    return $resultados;
}

switch ($comando) {
    case 'ayuda': case '--help': case '-h':
        $resultados = mostrarAyuda(); break;

    case 'version': case '--version': case '-v':
        $resultados = mostrarVersion($directorioRaiz); break;

    // ==================== CREAR (LOTES) ====================
    case 'crear:controlador':
        if (!$subcomando) { $resultados = [C_ROJO."❌ Especifica el nombre.".C_RESET]; break; }
        $resultados = procesarLote($subcomando, function($nombre) use ($directorioRaiz) {
            return crearControlador($directorioRaiz, $nombre);
