        $resultados = procesarLote($subcomando, function($nombre) use ($directorioRaiz) {
            return crearVista($directorioRaiz, $nombre);
        }); break;
        
    case 'crear:middleware':
        if (!$subcomando) { $resultados = [C_ROJO."❌ Especifica el nombre.".C_RESET]; break; }
        $resultados = procesarLote($subcomando, function($nombre) use ($directorioRaiz) {
            return crearMiddleware($directorioRaiz, $nombre);
        }); break;
        
    case 'crear:ruta':
        if (!$subcomando) { $resultados = [C_ROJO."❌ Especifica el nombre.".C_RESET]; break; }
        $resultados = procesarLote($subcomando, function($nombre) use ($directorioRaiz) {
            return crearRuta($directorioRaiz, $nombre);
        }); break;
        
    case 'crear:api':
        if (!$subcomando) { $resultados = [C_ROJO."❌ Especifica el nombre.".C_RESET]; break; }
        $resultados = procesarLote($subcomando, function($nombre) use ($directorioRaiz) {
            return crearApi($directorioRaiz, $nombre);
        }); break;
        
    case 'crear:admin':
        if (!$subcomando) { $resultados = [C_ROJO."❌ Especifica el nombre.".C_RESET]; break; }
        $resultados = procesarLote($subcomando, function($nombre) use ($directorioRaiz) {
            return crearAdmin($directorioRaiz, $nombre);
        }); break;
        
    case 'crear:migracion':
        if (!$subcomando) { $resultados = [C_ROJO."❌ Especifica el nombre.".C_RESET]; break; }
        $resultados = procesarLote($subcomando, function($nombre) use ($directorioRaiz) {
            return crearMigracion($directorioRaiz, $nombre);
        }); break;
        
    case 'crear:seeder':
        if (!$subcomando) { $resultados = [C_ROJO."❌ Especifica el nombre.".C_RESET]; break; }
        $resultados = procesarLote($subcomando, function($nombre) use ($directorioRaiz) {
            return crearSeeder($directorioRaiz, $nombre);
        }); break;

    // ==================== NUEVO: CREAR TABLA ====================
    case 'crear:tabla':
        if (!$subcomando || !$argumento) {
            $resultados = [C_ROJO."❌ Uso: php raiz crear:tabla NombreTabla \"SQL\" o archivo.sql".C_RESET];
            break;
        }
        $resultados = crearTabla($directorioRaiz, $subcomando, $argumento);
        break;

    // ==================== NUEVO: CONSULTA SQL ====================
    case 'db:consulta':
        if (!$subcomando) {
            $resultados = [C_ROJO."❌ Uso: php raiz db:consulta \"SELECT ...\"".C_RESET];
            break;
        }
        $resultados = ejecutarConsulta($directorioRaiz, $subcomando);
        break;

    // ==================== NUEVO: CARGAR ARCHIVO SQL ====================
    case 'cargar:sql':
        if (!$subcomando || !$argumento) {
            $resultados = [C_ROJO."❌ Uso: php raiz cargar:sql nombre archivo.sql".C_RESET];
            break;
        }
        $resultados = cargarSQL($directorioRaiz, $subcomando, $argumento);
        break;

    case 'migrar': $gestor = new App\Nucleo\GestorMigraciones($directorioRaiz); $resultados = $gestor->migrar(); break;
    case 'revertir': $gestor = new App\Nucleo\GestorMigraciones($directorioRaiz); $resultados = $gestor->revertir(); break;
    case 'migrar:estado': $resultados = migrarEstado($directorioRaiz); break;
    case 'migrar:fuerza': $gestor = new App\Nucleo\GestorMigraciones($directorioRaiz); $resultados = $gestor->migrar(true); break;
    case 'seed': $resultados = ejecutarSeeders($directorioRaiz); break;

    case 'db:respaldar': $resultados = respaldarBD($directorioRaiz); break;
    case 'db:restaurar':
        if (!$subcomando) { $resultados = [C_ROJO."❌ Especifica el archivo.".C_RESET]; break; }
        $resultados = restaurarBD($directorioRaiz, $subcomando); break;

    case 'cache:limpiar': (new App\Nucleo\Cache())->limpiarTodo(); $resultados = [C_VERDE."✅ Caché limpiada.".C_RESET]; break;
    case 'cache:estado': $resultados = cacheEstado($directorioRaiz); break;

    case 'lista:rutas': $resultados = listarRutas($directorioRaiz); break;
    case 'lista:middlewares': $resultados = listarMiddlewares($directorioRaiz); break;
    case 'lista:controladores': $resultados = listarControladores($directorioRaiz); break;

    case 'clave:generar': $resultados = generarClave($directorioRaiz); break;
    case 'log:limpiar': $resultados = limpiarLogs($directorioRaiz); break;
    case 'log:ver': $resultados = verLogs($directorioRaiz, $subcomando ?? '20'); break;

    case 'usuario:crear': $resultados = crearUsuario(); break;
    case 'usuario:rol':
        if (!$subcomando || !$argumento) { $resultados = [C_ROJO."❌ Uso: php raiz usuario:rol email rol".C_RESET]; break; }
        $resultados = cambiarRol($subcomando, $argumento); break;
    case 'token:generar':
        if (!$subcomando) { $resultados = [C_ROJO."❌ Especifica el email.".C_RESET]; break; }
        $resultados = generarToken($subcomando); break;

    case 'servir':
        $puerto = $subcomando ?? '8000';
        echo C_CYAN."🚀 Servidor en http://localhost:$puerto".C_RESET.PHP_EOL;
        echo C_AMARILLO."Presiona Ctrl+C para detener.".C_RESET.PHP_EOL;
        exec("php -S localhost:$puerto -t ".$directorioRaiz."/public"); exit;

    case 'proyecto:info': $resultados = infoProyecto($directorioRaiz); break;
    case 'proyecto:entorno': $resultados = cambiarEntorno($directorioRaiz, $subcomando); break;

    default:
