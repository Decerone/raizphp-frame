    $c = "<?php\ndeclare(strict_types=1);\n\nnamespace App\\Controladores;\n\nuse App\\Nucleo\\ControladorBase;\n\nclass {$nombre}Controlador extends ControladorBase\n{\n    public function index(): void\n    {\n        \$this->renderizar('".strtolower($nombre)."/index', ['titulo' => '$nombre']);\n    }\n}\n";
