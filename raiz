        C_AMARILLO."📋 Info:".C_RESET,
        "   PHP mínimo: {$f['php_minimo']} | Licencia: {$f['licencia']}",
        "   Autor: {$f['autor']} — {$f['pais_origen']} 🇨🇷",
        "   Repo: {$f['repo']}",
    ];
}

// ==================== NUEVO: CREAR TABLA ====================
function crearTabla(string $dir, string $nombre, string $sqlOArchivo): array
{
    $cfg = require $dir . '/config/aplicacion.php';
    if (($cfg['entorno'] ?? 'produccion') !== 'desarrollo') {
        return [C_ROJO."❌ Solo disponible en entorno desarrollo.".C_RESET];
    }
    
    // Si es archivo .sql, leerlo
    if (str_ends_with($sqlOArchivo, '.sql') && file_exists($sqlOArchivo)) {
        $sql = file_get_contents($sqlOArchivo);
    } else {
        $sql = $sqlOArchivo;
    }
    
    // Validar que sea CREATE TABLE
    if (stripos(trim($sql), 'CREATE TABLE') !== 0) {
        return [C_ROJO."❌ Solo se permiten sentencias CREATE TABLE.".C_RESET];
    }
    
    echo C_AMARILLO . "⚠️  Crear tabla: " . C_CYAN . $nombre . C_RESET . PHP_EOL;
    echo C_AMARILLO . "¿Ejecutar? (s/n): " . C_RESET;
    $confirmacion = strtolower(trim(fgets(STDIN)));
    if ($confirmacion !== 's' && $confirmacion !== 'si' && $confirmacion !== 'y') {
        return [C_AMARILLO . "❌ Cancelado." . C_RESET];
    }
    
    try {
        $db = App\Nucleo\Aplicacion::obtenerInstancia()->obtenerConexion();
        $pdo = $db->obtenerPDO();
        $pdo->exec($sql);
        return [C_VERDE . "✅ Tabla '{$nombre}' creada correctamente." . C_RESET];
    } catch (PDOException $e) {
        return [C_ROJO . "❌ Error: " . $e->getMessage() . C_RESET];
    }
}

// ==================== NUEVO: CONSULTA SELECT ====================
function ejecutarConsulta(string $dir, string $sql): array
{
    // Validar que sea SELECT
    if (stripos(trim($sql), 'SELECT') !== 0) {
        return [C_ROJO."❌ Solo se permiten consultas SELECT.".C_RESET];
    }
    
    try {
        $db = App\Nucleo\Aplicacion::obtenerInstancia()->obtenerConexion();
        $pdo = $db->obtenerPDO();
        $stmt = $pdo->query($sql);
        $resultados = $stmt->fetchAll(PDO::FETCH_ASSOC);
        
        $salida = [C_VERDE . "✅ " . count($resultados) . " resultados." . C_RESET, ""];
        
        if (empty($resultados)) {
            $salida[] = C_AMARILLO . "   Sin resultados." . C_RESET;
            return $salida;
        }
        
        // Mostrar nombres de columnas
        $columnas = array_keys($resultados[0]);
        $salida[] = C_CYAN . "   " . implode(" | ", $columnas) . C_RESET;
        $salida[] = C_CYAN . "   " . str_repeat('─', 50) . C_RESET;
        
        // Mostrar filas (máximo 20)
        $count = 0;
        foreach ($resultados as $row) {
            if ($count++ >= 20) {
                $salida[] = C_AMARILLO . "   ... y " . (count($resultados) - 20) . " más" . C_RESET;
                break;
            }
            $salida[] = "   " . implode(" | ", array_map(fn($v) => is_null($v) ? 'NULL' : (string)$v, $row));
        }
        
        return $salida;
    } catch (PDOException $e) {
        return [C_ROJO . "❌ Error: " . $e->getMessage() . C_RESET];
    }
}

// ==================== NUEVO: CARGAR ARCHIVO SQL ====================
function cargarSQL(string $dir, string $nombre, string $archivo): array
{
    if (!file_exists($archivo)) {
        return [C_ROJO."❌ Archivo no encontrado: {$archivo}".C_RESET];
    }
    
    $sql = file_get_contents($archivo);
    
    echo C_AMARILLO . "⚠️  Cargar: " . C_CYAN . $nombre . C_RESET . PHP_EOL;
    echo C_AMARILLO . "   Archivo: " . basename($archivo) . " (" . strlen($sql) . " bytes)" . C_RESET . PHP_EOL;
    echo C_AMARILLO . "¿Ejecutar? (s/n): " . C_RESET;
    
    $confirmacion = strtolower(trim(fgets(STDIN)));
    if ($confirmacion !== 's' && $confirmacion !== 'si' && $confirmacion !== 'y') {
        return [C_AMARILLO . "❌ Cancelado." . C_RESET];
    }
    
    try {
        $db = App\Nucleo\Aplicacion::obtenerInstancia()->obtenerConexion();
        $pdo = $db->obtenerPDO();
        $pdo->exec($sql);
        return [C_VERDE . "✅ Archivo '{$nombre}' cargado correctamente." . C_RESET];
    } catch (PDOException $e) {
        return [C_ROJO . "❌ Error: " . $e->getMessage() . C_RESET];
    }
}

