    @mkdir($dir.'/almacenamiento/backups', 0775, true);
    $f = $dir.'/almacenamiento/backups/backup_'.date('Ymd_His').'.sql';
    exec("mysqldump -h{$cfg['host']} -u{$cfg['usuario']} ".($cfg['clave']?"-p{$cfg['clave']}":"")." {$cfg['nombre']} > $f 2>/dev/null", $o, $x);
    return $x===0 ? [C_VERDE."✅ Backup: $f".C_RESET] : [C_ROJO."❌ Error.".C_RESET];
}

function restaurarBD(string $dir, string $f): array {
    if (!file_exists($f)) return [C_ROJO."❌ No encontrado.".C_RESET];
    $cfg = require $dir.'/config/base_datos.php';
    exec("mysql -h{$cfg['host']} -u{$cfg['usuario']} ".($cfg['clave']?"-p{$cfg['clave']}":"")." {$cfg['nombre']} < $f 2>/dev/null", $o, $x);
    return $x===0 ? [C_VERDE."✅ Restaurado.".C_RESET] : [C_ROJO."❌ Error.".C_RESET];
}

function cacheEstado(string $dir): array {
    $a = glob($dir.'/almacenamiento/cache/*'); $t = count($a); $s = 0;
    foreach ($a as $f) $s += filesize($f);
    return [C_CYAN."📊 Caché: ".C_AMARILLO."$t archivos, ".round($s/1024,2)." KB".C_RESET];
}

function listarRutas(string $dir): array {
    $r = [C_CYAN."📋 Rutas:".C_RESET];
    foreach (glob($dir.'/app/rutas/*.php') as $f) {
        $n = basename($f); $c = file_get_contents($f);
        preg_match_all("/agregarRuta\('(GET|POST|PUT|DELETE)',\s*'([^']+)'/", $c, $m);
        $r[] = C_MORADO."  📁 $n".C_RESET;
        for ($i=0; $i<count($m[0]); $i++) $r[] = "     ".C_AZUL.str_pad($m[1][$i],6).C_RESET." ".$m[2][$i];
    }
    return $r;
}

function listarMiddlewares(string $dir): array {
    $r = [C_CYAN."📋 Middlewares:".C_RESET];
    foreach (glob($dir.'/app/Middleware/Middleware*.php') as $f) $r[] = "   📦 ".C_MORADO.basename($f,'.php').C_RESET;
    return $r;
}

function listarControladores(string $dir): array {
    $r = [C_CYAN."📋 Controladores:".C_RESET];
    foreach ([$dir.'/app/Controladores/', $dir.'/app/Controladores/Admin/', $dir.'/app/Controladores/Api/'] as $d) {
        foreach (glob($d.'*Controlador.php') as $f) {
            $t = str_contains($d,'Admin')?'Admin':(str_contains($d,'Api')?'API':'Web');
            $r[] = "   ".C_AZUL.str_pad("[$t]",8).C_RESET." ".basename($f,'.php');
        }
    }
    return $r;
}

function generarClave(string $dir): array {
    $k = bin2hex(random_bytes(32));
    file_put_contents($dir.'/config/aplicacion.php', preg_replace("/'clave_aplicacion'\s*=>\s*'[^']*'/", "'clave_aplicacion' => '$k'", file_get_contents($dir.'/config/aplicacion.php')));
    return [C_VERDE."✅ Clave: $k".C_RESET];
}

function limpiarLogs(string $dir): array {
    $a = glob($dir.'/almacenamiento/logs/*.log'); foreach ($a as $f) unlink($f);
    return [C_VERDE."✅ Logs limpiados (".count($a).")".C_RESET];
}

function verLogs(string $dir, string $n): array {
    $f = $dir.'/almacenamiento/logs/app.log';
    if (!file_exists($f)) return [C_AMARILLO."⚠️ Sin logs.".C_RESET];
    $l = array_slice(file($f), -intval($n));
    return array_merge([C_CYAN."📋 Log:".C_RESET,""], array_map(fn($x)=> "   ".trim($x), $l));
}

function crearUsuario(): array {
    echo C_CYAN."👤 Nuevo usuario".C_RESET.PHP_EOL;
    echo "Nombre: "; $n=trim(fgets(STDIN));
    echo "Apellido: "; $a=trim(fgets(STDIN));
    echo "Email: "; $e=trim(fgets(STDIN));
    echo "Contraseña: "; $p=trim(fgets(STDIN));
    echo "Edad: "; $ed=intval(trim(fgets(STDIN)));
    $db = App\Nucleo\Aplicacion::obtenerInstancia()->obtenerConexion();
    $db->insertar('usuarios', ['nombre'=>$n,'apellido'=>$a,'email'=>$e,'password'=>password_hash($p,PASSWORD_BCRYPT),'edad'=>$ed,'rol'=>'usuario']);
    return [C_VERDE."✅ Usuario: $e".C_RESET];
}

function cambiarRol(string $e, string $r): array {
    App\Nucleo\Aplicacion::obtenerInstancia()->obtenerConexion()->actualizar('usuarios', ['rol'=>$r], "email='$e'");
    return [C_VERDE."✅ Rol de $e → $r".C_RESET];
}

function generarToken(string $e): array {
    $t = bin2hex(random_bytes(32));
    App\Nucleo\Aplicacion::obtenerInstancia()->obtenerConexion()->actualizar('usuarios', ['api_token'=>$t], "email='$e'");
    return [C_VERDE."✅ Token: $t".C_RESET];
}

function infoProyecto(string $dir): array {
    $c = require $dir.'/config/aplicacion.php';
    return [C_CYAN."📋 Proyecto:".C_RESET,"   Nombre: ".C_AMARILLO.($c['nombre']??'N/A').C_RESET,"   Entorno: ".C_AMARILLO.($c['entorno']??'N/A').C_RESET,"   PHP: ".C_AMARILLO.PHP_VERSION.C_RESET];
}

function cambiarEntorno(string $dir, ?string $e): array {
    if (!$e) { $c = require $dir.'/config/aplicacion.php'; return [C_CYAN."Entorno: ".C_AMARILLO.($c['entorno']??'N/A').C_RESET]; }
    file_put_contents($dir.'/config/aplicacion.php', preg_replace("/'entorno'\s*=>\s*'[^']*'/", "'entorno' => '$e'", file_get_contents($dir.'/config/aplicacion.php')));
    return [C_VERDE."✅ Entorno → $e".C_RESET];
}